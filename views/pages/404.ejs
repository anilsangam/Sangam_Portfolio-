<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', { isRoom: false }) %>
</head>
<body style="min-height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 24px;">
    <div>
        <h1 style="font-size: 5rem; font-weight: 800; margin-bottom: 12px; color: var(--foreground);">404</h1>
        <h2 style="font-size: 1.5rem; margin-bottom: 16px; color: var(--muted);">Page Not Found</h2>
        <p style="margin-bottom: 32px; color: var(--subtle); max-width: 400px; margin-left: auto; margin-right: auto;">
            The page you are looking for doesn't exist or has moved.
        </p>
        <a href="/" class="chip" style="display: inline-block; padding: 12px 28px; background: var(--surface); color: var(--foreground); border-radius: 9999px; text-decoration: none; font-weight: 600;">
            ← Return to Homepage
        </a>
    </div>
</body>
</html>

