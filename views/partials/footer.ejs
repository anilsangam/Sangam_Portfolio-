<footer class="sf" id="contact-footer" aria-labelledby="sfTitle">
    <% const footerWhatsapp = '916207314168'; %>
    <div class="sf__in sf__compact">
        <div class="sf__top">
            <div class="sf__intro">
                <p class="sf__eye"><i></i><%= (profile && profile.availabilityStatus) || '' %></p>
                <h2 class="sf__h" id="sfTitle">Want to build your project?<span>Let's make it happen.</span></h2>
                <p class="sf__p"><%= (profile && profile.subheadline) || '' %></p>
            </div>
        <div class="sf__cta">
            <button class="sf__btn" data-contact>Let's discuss<b><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></b></button>
            <a href="https://wa.me/<%= footerWhatsapp %>" class="sf__ghost sf__whatsapp" target="_blank" rel="noopener noreferrer" aria-label="Contact on WhatsApp"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16.02 3.2A12.7 12.7 0 0 0 5.1 22.37L3.4 28.6l6.38-1.67A12.72 12.72 0 1 0 16.02 3.2Zm0 23.1c-1.96 0-3.88-.53-5.56-1.54l-.4-.24-3.78.99 1.01-3.68-.26-.42a10.35 10.35 0 1 1 8.99 4.9Zm5.68-7.75c-.31-.16-1.84-.91-2.12-1.01-.28-.1-.49-.16-.69.16-.2.31-.8 1.01-.98 1.22-.18.2-.36.23-.67.08-.31-.16-1.31-.49-2.5-1.55-.92-.82-1.55-1.84-1.73-2.15-.18-.31-.02-.48.14-.63.14-.14.31-.36.47-.54.16-.18.21-.31.31-.52.1-.2.05-.39-.02-.54-.08-.16-.69-1.67-.95-2.29-.25-.6-.5-.52-.69-.53h-.59c-.2 0-.52.08-.8.39-.28.31-1.05 1.03-1.05 2.5s1.08 2.91 1.23 3.11c.16.21 2.13 3.25 5.15 4.56.72.31 1.28.5 1.72.64.72.23 1.37.2 1.89.12.58-.09 1.84-.75 2.1-1.47.26-.72.26-1.34.18-1.47-.08-.13-.28-.21-.59-.36Z"/></svg><span>WhatsApp</span></a>
        </div>
        </div>

        <div class="sf__footer-row">
            <div class="sf__quick-nav">
                <h3>Quick nav</h3>
                <nav class="sf__footer-nav" aria-label="Footer navigation">
                    <a href="/">Home</a>
                    <a href="/#projectsShowcase">Selected work</a>
                    <a href="/web-developer">Web</a>
                    <a href="/app-developer">Apps</a>
                    <a href="/#about">My story</a>
                    <a href="/#skills">Tech stack</a>
                    <a href="/#contact-footer">Contact</a>
                </nav>
            </div>
            <div class="sf__connect">
                <h3>Connect</h3>
                <div class="sf__socials" aria-label="Social links">
                <% if (profile && profile.socialLinks && profile.socialLinks.github) { %><a href="<%= profile.socialLinks.github %>" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.53v-2.08c-3.1.67-3.76-1.32-3.76-1.32-.5-1.29-1.24-1.63-1.24-1.63-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 .1.73 2.41 4.04 1.72.1-.72.39-1.2.7-1.48-2.48-.28-5.1-1.24-5.1-5.53 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.06 1.14a10.6 10.6 0 0 1 5.57 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.54.23 2.68.12 2.96.71.78 1.14 1.78 1.14 3 0 4.3-2.62 5.24-5.12 5.52.4.35.75 1.03.75 2.08V22c0 .3.2.64.77.53A11.1 11.1 0 0 0 12 .9Z"/></svg></a><% } %>
                <% if (profile && profile.socialLinks && profile.socialLinks.twitter) { %><a href="<%= profile.socialLinks.twitter %>" target="_blank" rel="noopener noreferrer" aria-label="X or Twitter" title="X / Twitter"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2H22l-6.78 7.75L23.2 22h-6.25l-4.9-7.42L5.56 22H2.42l7.25-8.29L1.8 2h6.4l4.43 6.96L18.9 2Zm-1.1 18h1.73L7.27 3.89H5.41L17.8 20Z"/></svg></a><% } %>
                <% if (profile && profile.socialLinks && profile.socialLinks.linkedin) { %><a href="<%= profile.socialLinks.linkedin %>" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.7H4.98V9.2h2.95v9.5ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.25 10.8h-2.94v-4.62c0-1.1-.02-2.52-1.54-2.52-1.55 0-1.79 1.2-1.79 2.44v4.7H9.5V9.2h2.82v1.3h.04c.39-.75 1.35-1.54 2.78-1.54 2.98 0 3.56 1.96 3.56 4.5v5.24Z"/></svg></a><% } %>
                <% if (profile && profile.socialLinks && profile.socialLinks.instagram) { %><a href="<%= profile.socialLinks.instagram %>" target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2.1A2.9 2.9 0 0 0 4.1 7v10A2.9 2.9 0 0 0 7 19.9h10a2.9 2.9 0 0 0 2.9-2.9V7A2.9 2.9 0 0 0 17 4.1H7Zm5 2.5a5.4 5.4 0 1 1 0 10.8 5.4 5.4 0 0 1 0-10.8Zm0 2.1a3.3 3.3 0 1 0 0 6.6 3.3 3.3 0 0 0 0-6.6Zm5.65-3.7a1.27 1.27 0 1 1 0 2.54 1.27 1.27 0 0 1 0-2.54Z"/></svg></a><% } %>
                <% if (profile && profile.email) { %><a href="mailto:<%= profile.email %>" aria-label="Email" title="Email"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h18a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm0 2v.5l9 6 9-6V6H3Zm18 12V8.9l-8.45 5.63a1 1 0 0 1-1.1 0L3 8.9V18h18Z"/></svg></a><% } %>
                </div>
            </div>
        </div>

        <div class="sf__contact-row">
            <% if (profile && profile.email) { %><a href="mailto:<%= profile.email %>"><span>Email</span><%= profile.email %></a><% } %>
            <% if (profile && profile.phoneNumber) { %><a href="tel:<%= profile.phoneNumber.replace(/[^\d+]/g, '') %>"><span>Phone</span><%= profile.phoneNumber %></a><% } %>
            <% if (profile && profile.location) { %><span class="sf__location"><span>Based in</span><%= profile.location %></span><% } %>
        </div>

        <div class="sf__bot"><span>&copy; <span data-fyear><%= new Date().getFullYear() %></span> <%= (profile && profile.fullName) || "Anil Sangam" %>. All rights reserved.</span></div>
    </div>
</footer>
