<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title><%= pageTitle %></title>
<link rel="preload" href="/fonts/onest-latin.woff2" as="font" type="font/woff2" crossorigin>
<style>
    @font-face {
        font-family: 'Onest';
        font-style: normal;
        font-display: swap;
        font-weight: 100 900;
        src: url(/fonts/onest-latin.woff2) format('woff2');
        unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
    }
    @font-face {
        font-family: 'Onest';
        font-style: normal;
        font-display: swap;
        font-weight: 100 900;
        src: url(/fonts/onest-latin-ext.woff2) format('woff2');
        unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;
    }
</style>
<meta name="description" content="<%= (settings && settings.metaDescription) || (profile && profile.subheadline) || 'Freelance developer and designer building websites and iOS apps for clients worldwide.' %>"/>
<meta name="theme-color" content="#1A1818"/>
<link rel="stylesheet" href="/css/<%= typeof isRoom !== 'undefined' && isRoom ? 'room.css' : 'main.css' %>">
<link rel="stylesheet" href="/css/books-showcase.css">
<link rel="stylesheet" href="/css/scroll-cards.css">
<script type="importmap">
{
    "imports": {
        "three": "/vendor/three.module.js"
    }
}
</script>
<script>
    try {
        if (localStorage.getItem('anil-mode') === 'dark') {
            document.documentElement.dataset.mode = 'dark';
        } else if (localStorage.getItem('anil-mode') === 'light') {
            document.documentElement.dataset.mode = 'light';
        }
    } catch(e) {}
</script>
