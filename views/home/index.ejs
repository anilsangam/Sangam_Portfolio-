                c.lineWidth = thick + 1;
                c.lineCap = 'round';
                pathThrough(c, ps);
                c.stroke();
                c.fillStyle = `rgba(0,0,0,${sa})`;
                drawKnob(c, last.x, last.y, ang, true);
                c.restore();

                // brushed steel cable with a dark outer sheath and a bright highlight
                c.lineCap = 'round';
                c.lineJoin = 'round';
                pathThrough(c, ps);
                c.strokeStyle = '#050608';
                c.lineWidth = thick + 1.8;
                c.stroke();
                c.strokeStyle = '#25272d';
                c.lineWidth = thick;
                c.stroke();
