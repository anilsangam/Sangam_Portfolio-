    const pageProfile = profile || {};
    const profileName = (pageProfile.fullName || '').trim();
    const firstName = profileName.split(/\s+/)[0] || '';
    const heroRoles = Array.isArray(pageProfile.heroSkills) ? pageProfile.heroSkills.filter(Boolean) : [];
    const storyEntries = [
        ...(experience || []).map(item => ({
            year: String(item.year || item.period || '').match(/\d{4}/)?.[0] || '',
            when: item.period || item.year || '',
            title: item.role || '',
            org: [item.company, item.location].filter(Boolean).join(' · '),
            details: item.highlights?.length ? item.highlights : (item.description ? [item.description] : [])
        })),
        ...(education || []).map(item => ({
            year: String(item.year || item.period || '').match(/\d{4}/)?.[0] || '',
            when: item.period || item.year || '',
            title: item.degree || '',
            org: item.institution || '',
            details: item.description ? [item.description] : []
        }))
    ].filter(item => item.title).sort((a, b) => Number(b.year || 0) - Number(a.year || 0));
    const pageSkills = skills || [];
    const skillGroups = [...new Set(pageSkills.map(item => item.category).filter(Boolean))]
        .map(category => ({ category, items: pageSkills.filter(item => item.category === category) }));
%>
