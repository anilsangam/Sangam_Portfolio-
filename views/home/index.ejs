                c.restore();
            }
            function draw() {
                const c = ctx;
                c.setTransform(dpr, 0, 0, dpr, 0, 0);
                c.clearRect(0, 0, W, H);
                const ps = pts;
                const last = ps[N]
                  , prev = ps[N - 1];
                const ang = Math.atan2(last.y - prev.y, last.x - prev.x);

                // cast shadow on the wall behind
                const sa = parseFloat(getComputedStyle(root).getPropertyValue('--cord-shadow')) || .2;
                c.save();
                c.translate(7, 11);
                if ('filter' in c)
                    c.filter = 'blur(3px)';
