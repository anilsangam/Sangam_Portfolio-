    <script type="importmap">
        {
            "imports": {
                "lenis": "/vendor/lenis.min.mjs"
            }
        }</script>
    <script type="module">
        const COLOUR_SRC = "<%= (profile && profile.heroImageColor) ? profile.heroImageColor : '/uploads/anil_sangam_colour.png' %>";
        // revealed under the cursor
        const $ = (s, r=document) => r.querySelector(s);
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
        const root = document.documentElement;

        /* ---------- adaptive grid scale-up above 1920px ---------- */
        function applyAdaptiveGrid() {
            const FONT_BASE = 16
              , baseWidth = 1920
              , coef = 0.6666;
            const w = window.innerWidth;
            const widthReduction = ((baseWidth - w) / baseWidth) * 100;
            const size = FONT_BASE - (FONT_BASE * (widthReduction * coef)) / 100;
            if (size > FONT_BASE)
                root.style.fontSize = size + 'px';
            else
                root.style.removeProperty('font-size');
        }
        applyAdaptiveGrid();
        addEventListener('resize', applyAdaptiveGrid);

        /* ---------- scroll lock (Lenis attached once loaded) ---------- */
        let lenis = null
          , scrollEnabled = true
          , locks = 0;
        // touch state shared by the pinned sections: never snap while a finger is down or a flick is still coasting
        window.__touching = false;
        addEventListener('touchstart', () => {
            window.__touching = true;
        }
        , {
            passive: true,
            capture: true
        });
        addEventListener('touchend', () => {
            window.__touching = false;
        }
        , {
            passive: true,
            capture: true
        });
        addEventListener('touchcancel', () => {
            window.__touching = false;
        }
        , {
            passive: true,
            capture: true
        });
        const COARSE = matchMedia('(pointer: coarse)').matches;
        window.__snapTo = top => {
            if (!COARSE && window.__lenis)
                window.__lenis.scrollTo(top, {
                    duration: .6,
                    easing: x => 1 - Math.pow(1 - x, 3)
                });
            else
                scrollTo({
                    top,
                    behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
                });
        }
        ;
        function stopScroll() {
            locks++;
            scrollEnabled = false;
            lenis?.stop();
            Object.assign(root.style, {
                position: 'relative',
                overflow: 'hidden',
                height: '100%'
            });
        }
        function startScroll() {
            locks = Math.max(0, locks - 1);
            if (locks)
                return;
            scrollEnabled = true;
            lenis?.start();
            root.style.removeProperty('position');
            root.style.removeProperty('overflow');
            root.style.removeProperty('height');
        }
        function scrollToId(id) {
            const el = document.getElementById(id);
            if (!el)
                return;
            scrollEnabled = false;
            setTimeout( () => {
                const top = el.getBoundingClientRect().top + window.pageYOffset;
                if (lenis)
                    lenis.scrollTo(top);
                else
                    window.scrollTo({
                        top,
                        behavior: 'smooth'
                    });
                setTimeout( () => {
                    scrollEnabled = true;
                }
                , 100);
            }
            , 50);
        }
        window.scrollTo(0, 0);

        /* ---------- spring helper (mass 1, semi-implicit Euler) ---------- */
        function spring({tension, friction}, render) {
            let x = 0
              , v = 0
              , target = 0
              , raf = 0;
            const step = () => {
                const dt = 1 / 60
                  , a = tension * (target - x) - friction * v;
                v += a * dt;
                x += v * dt;
                render(x);
                if (Math.abs(target - x) < 0.001 && Math.abs(v) < 0.001) {
                    x = target;
                    v = 0;
                    render(x);
                    raf = 0;
                    return;
                }
                raf = requestAnimationFrame(step);
            }
            ;
            render(0);
            return {
                set(t) {
                    target = t;
                    if (!raf)
                        raf = requestAnimationFrame(step);
                }
            };
        }
        // declarative hovers: data-h="s 1 1.04|y 0 -2|o .8 1"  data-hs="tension friction"  data-ht="closest trigger"
        function bindHovers(scope=document) {
            scope.querySelectorAll('[data-h]').forEach(el => {
                if (el._h)
                    return;
                el._h = 1;
                const props = el.dataset.h.split('|').map(p => {
                    const [k,a,b] = p.trim().split(/\s+/);
                    return {
                        k,
                        a: +a,
                        b: +b
                    };
                }
                );
                const [tension,friction] = (el.dataset.hs || '320 18').split(/\s+/).map(Number);
                const trig = el.dataset.ht ? el.closest(el.dataset.ht) || el : el;
                const render = p => {
                    const v = {
                        s: 1,
                        x: 0,
                        y: 0,
                        r: 0
                    };
                    let o = null;
                    props.forEach( ({k, a, b}) => {
                        const val = a + (b - a) * p;
                        if (k === 'o')
                            o = val;
                        else
                            v[k] = val;
                    }
                    );
                    el.style.transform = `translate(${v.x}px,${v.y}px) rotate(${v.r}deg) scale(${v.s})`;
                    if (o !== null)
                        el.style.opacity = o;
                }
                ;
                const s = spring({
                    tension,
                    friction
                }, render);
                if (!canHover)
                    return;
                trig.addEventListener('mouseenter', () => s.set(1));
                trig.addEventListener('mouseleave', () => s.set(0));
                trig.addEventListener('focusin', () => s.set(1));
                trig.addEventListener('focusout', () => s.set(0));
            }
            );
        }

        /* ---------- sticky header: gets a soft backing once the page scrolls ---------- */
        {
            const hdr = $('.site-header') || $('.hdr');
            const upd = () => { if (hdr) hdr.classList.toggle('stuck', scrollY > 24); };
            addEventListener('scroll', upd, {
                passive: true
            });
            upd();
        }
        /* ---------- overlays ---------- */
        const FOCUSABLE = 'a[href],button:not([disabled]),input:not([disabled]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex="-1"])';
        function openLayer(el, onKey) {
            el.hidden = false;
            stopScroll();
            requestAnimationFrame( () => requestAnimationFrame( () => el.classList.add('open')));
            el._key = e => {
                if (e.key === 'Escape') {
                    onKey();
                    return;
                }
                // keep Tab inside the open layer: without this the keyboard walks onto the page behind it
                if (e.key !== 'Tab')
                    return;
                const f = [...el.querySelectorAll(FOCUSABLE)].filter(n => n.offsetWidth || n.offsetHeight || n.getClientRects().length);
                if (!f.length)
                    return;
                const first = f[0]
                  , last = f[f.length - 1];
                if (!el.contains(document.activeElement)) {
                    e.preventDefault();
                    first.focus();
                    return;
                }
                if (e.shiftKey && document.activeElement === first) {
                    e.preventDefault();
                    last.focus();
                } else if (!e.shiftKey && document.activeElement === last) {
                    e.preventDefault();
                    first.focus();
                }
            }
            ;
            addEventListener('keydown', el._key);
        }
        function closeLayer(el, after) {
            if (el.hidden)
                return;
            el.classList.remove('open');
            el.classList.add('closing');
            removeEventListener('keydown', el._key);
            setTimeout( () => {
                el.hidden = true;
                el.classList.remove('closing');
                startScroll();
                after?.();
            }
            , 460);
        }
        // Global helper for opening modal or doors
        window.openModal = () => {
            const m = $('#modal');
            if (m) {
                m.hidden = false;
                m.classList.add('on');
                document.body.style.overflow = 'hidden';
            }
        };
        // request modal
        const CONTACT_EMAIL = document.body.dataset.contactEmail || '';
        // where project requests go (assembled here so address-harvesting bots don't find it in the page)
        document.querySelectorAll('[data-mail]').forEach(a => {
            a.href = 'mailto:' + CONTACT_EMAIL;
            a.textContent = CONTACT_EMAIL;
        }
        );
        const modal = $('#modal')
          , form = $('#reqForm');
        let lastFocus = null;
        function openModal() {
            lastFocus = document.activeElement;
            openLayer(modal, closeModal);
            setTimeout( () => $('#f-name')?.focus({
                preventScroll: true
            }), 120);
        }
        let lastInput = 'mouse';
        addEventListener('pointerdown', () => {
            lastInput = 'mouse';
        }
        , true);
        addEventListener('keydown', e => {
            if (e.key === 'Tab' || e.key === 'Enter' || e.key === ' ')
                lastInput = 'key';
        }
        , true);
        function closeModal() {
            document.body.style.removeProperty('overflow');
            if (window.unlockScroll) window.unlockScroll();
            closeLayer(modal, () => {
                // give focus back only to keyboard users, so a mouse click doesn't leave the nav item looking hovered
                if (lastInput === 'key')
                    lastFocus?.focus?.({
                        preventScroll: true
                    });
                else
                    document.activeElement?.blur?.();
                setTimeout( () => {
                    form.reset();
                    $('#mForm').hidden = false;
                $('#mFormError').hidden = true;
                    $('#mSuccess').hidden = true;
                    $('#mSendLbl').textContent = SEND_LABEL;
                }
                , 300);
            }
            );
        }
        modal.addEventListener('click', closeModal);
        $('#mPanel').addEventListener('click', e => e.stopPropagation());
        $('#mClose').addEventListener('click', closeModal);
        $('#mDone').addEventListener('click', closeModal);
        // Store contact inquiries in the admin panel without opening an email client.
        const SEND_LABEL = 'Send inquiry';
        $('#mSendLbl').textContent = SEND_LABEL;
        form.addEventListener('submit', e => {
            e.preventDefault();
            const d = new FormData(form)
              , name = (d.get('name') || '').trim()
              , mail = (d.get('email') || '').trim()
              , phone = (d.get('phone') || '').trim()
