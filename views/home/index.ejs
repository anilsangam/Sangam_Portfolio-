    <script>
        // press F for full screen (again, or Esc, to leave); ignored while typing
        ( () => {
            const typing = e => {
                const t = e.target;
                return t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName));
            }
            ;
            const toggle = () => {
                const d = document
                  , el = d.documentElement;
                if (d.fullscreenElement || d.webkitFullscreenElement)
                    (d.exitFullscreen || d.webkitExitFullscreen).call(d);
                else
                    (el.requestFullscreen || el.webkitRequestFullscreen)?.call(el)?.catch?.( () => {}
                    );
            }
            ;
            addEventListener('keydown', e => {
                if ((e.key !== 'f' && e.key !== 'F') || e.metaKey || e.ctrlKey || e.altKey || typing(e))
                    return;
                e.preventDefault();
                if (window.top !== window) {
                    try {
                        parent.postMessage({
                            wall: 'fullscreen'
                        }, location.origin === 'null' ? '*' : location.origin);
                    } catch (_) {}
                    return;
                }
                toggle();
            }
            );
            if (window.top === window)
                addEventListener('message', e => {
                    // only one of this page's own frames can ask for full screen
                    if (!e.data || e.data.wall !== 'fullscreen' || ![...document.querySelectorAll('iframe')].some(f => f.contentWindow === e.source))
                        return;
                    toggle();
                }
                );
        }
        )();
    </script>
