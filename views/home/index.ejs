    <div class="ck" id="ck" role="region" aria-label="Analytics choice" hidden>
        <p>
            May I count your visit with Google Analytics? It sets cookies. <a href="/legal/">Details</a>
        </p>
        <div>
            <button type="button" data-ck="no">No thanks</button>
            <button type="button" data-ck="yes">Allow</button>
        </div>
