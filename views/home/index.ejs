            /* ----- drawing ----- */
            function pathThrough(c, ps) {
                c.beginPath();
                c.moveTo(ps[0].x, ps[0].y);
                for (let i = 1; i < ps.length - 1; i++) {
                    const mx = (ps[i].x + ps[i + 1].x) / 2
                      , my = (ps[i].y + ps[i + 1].y) / 2;
