# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# MongoDB Database Connection
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
# For Local MongoDB: mongodb://127.0.0.1:27017/portfolio
MONGODB_URI=

# Session Secret (change in production)
SESSION_SECRET=a_very_secure_and_long_random_session_secret_for_rishi_portfolio_2026

# Default Initial Admin Credentials (used by seed script)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@therishithakor.com
ADMIN_PASSWORD=Admin@Rishi2026!

# Cloudinary Media Storage (optional in development, recommended for production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

